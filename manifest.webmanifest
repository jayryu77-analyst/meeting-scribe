{
  "name": "NDR 미팅노트",
  "short_name": "미팅노트",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f8",
  "theme_color": "#022A52",
  "lang": "ko",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            "audio/*",
            "video/mp4",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".amr",
            ".3gp",
            ".ogg"
          ]
        }
      ]
    }
  }
}